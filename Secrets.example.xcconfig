// Copy this file to `Secrets.xcconfig` and fill in your Spotify Client ID.
// `Secrets.xcconfig` is gitignored so your Client ID is not committed.
//
// Get a Client ID:
//   1. https://developer.spotify.com/dashboard  ->  Create app
//   2. Redirect URI:  spotifymenubar://callback
//   3. Copy the Client ID below.
//
// (PKCE is used, so there is NO client secret to store.)

SPOTIFY_CLIENT_ID = your_client_id_here

// Optional — only needed for the Top Tracks (last.fm) feature.
// Get a free key at https://www.last.fm/api/account/create (any app name; no callback URL
// needed — the app only reads public listening history, so there is no login flow).
LASTFM_API_KEY = your_lastfm_api_key_here
