<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed content view — three big buttons, and a status line that is normally invisible.

  This layout is the whole point of the app: Android shows lock-screen notifications collapsed,
  and a *standard* notification hides its action buttons when collapsed. A custom content view is
  drawn as-is, so putting the buttons here is what makes Add/Remove reachable from the lock screen
  without expanding anything.

  No track title: Spotify's own media notification sits right above this one showing the song, so
  repeating it here only stole width from the buttons. @id/status_line keeps that rule — it stays
  gone until there is something wrong that the buttons can't say on their own (see
  CuratorNotification.statusLine).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/action_add"
            style="@style/CuratorNotificationGlyph"
            android:contentDescription="@string/action_add"
            android:text="@string/glyph_add" />

        <TextView
            android:id="@+id/action_remove"
            style="@style/CuratorNotificationGlyph"
            android:contentDescription="@string/action_remove"
            android:text="@string/glyph_remove" />

        <TextView
            android:id="@+id/action_skip"
            style="@style/CuratorNotificationGlyph"
            android:contentDescription="@string/action_skip"
            android:text="@string/glyph_skip" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_line"
        style="@style/CuratorNotificationStatus"
        android:visibility="gone" />

</LinearLayout>
