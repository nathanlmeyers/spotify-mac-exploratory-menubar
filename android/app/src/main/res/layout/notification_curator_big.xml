<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded content view: the same three actions with their full labels, plus the Discovery switch.

  No track title, artist or status line. Spotify's own media notification sits right above this
  one showing the song, so repeating it here said nothing new — and the standard action buttons
  that used to be attached alongside these (NotificationCompat.addAction) said it twice over. What
  expanding buys you is the labels and the Discovery row, nothing else.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/action_add"
            style="@style/CuratorNotificationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_add" />

        <TextView
            android:id="@+id/action_remove"
            style="@style/CuratorNotificationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_remove" />

        <TextView
            android:id="@+id/action_skip"
            style="@style/CuratorNotificationButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/action_skip" />
    </LinearLayout>

    <!--
      Discovery's whole effect is that the music stops a beat before every song ends. The moment
      you want it off is the moment it has just done that — which, before this, meant unlocking the
      phone and finding a toggle in the app. Label states what Discovery *is*; pressing flips it.
      Text is set in CuratorNotification, which is also where the press is wired.
    -->
    <TextView
        android:id="@+id/action_discovery"
        style="@style/CuratorNotificationButton"
        android:layout_width="match_parent" />
</LinearLayout>
